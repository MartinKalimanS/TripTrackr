{
  "name": "triptrackr",
  "version": "0.0.0",
  "private": true,
  "description": "TripTrackr monorepo — Expo mobile app, NestJS API, and the contracts they share",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "mobile": "npm run start -w apps/mobile",
    "api": "npm run start:dev -w apps/api",
    "build": "npm run build -w packages/contracts && npm run build -w apps/api",
    "build:contracts": "npm run build -w packages/contracts",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build:contracts && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "overrides": {
    "@react-native/jest-preset": "0.86.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
