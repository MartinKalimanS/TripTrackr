{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      // Type-check against the contracts SOURCE so `tsc --noEmit` never depends
      // on packages/contracts having been built first. Metro resolves the same
      // file through the package's `react-native` export condition.
      "@triptrackr/contracts": ["../../packages/contracts/src/index.ts"]
    },
    "types": ["jest", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", ".expo"]
}
