# ---------------------------------------------------------------------------
# Dependencies & build output (every workspace)
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Expo / React Native (apps/mobile)
# ---------------------------------------------------------------------------
.expo/
web-build/
expo-env.d.ts
.metro-health-check*
# Generated native projects — the dev-client workflow prebuilds them on demand.
apps/mobile/ios/
apps/mobile/android/
.kotlin/
*.orig.*

# Signing material. Never committed; EAS holds credentials.
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Maestro
.maestro/

# ---------------------------------------------------------------------------
# Secrets — Constitution: secrets MUST NOT be committed or baked into images.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
infra/secrets/

# ---------------------------------------------------------------------------
# Tooling & OS noise
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.stackdump
npm-debug.*
yarn-debug.*
yarn-error.*

# Agent tooling: keep the shared skills, ignore per-machine local state.
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/settings.local.json
.specify/feature.json
