# ---------------------------------------------------------------------------
# TripTrackr environment. Copy to the repository root and fill in:
#
#   cp .env.example .env
#
# The stock values below bring the development stack up with no edits. Every
# variable the API needs is validated at startup
# (apps/api/src/common/config/env.schema.ts) — a missing or malformed one stops
# the boot with the full list of problems, never a 500 on first use.
#
# Compose (infra/docker-compose.yml) loads this file into the api, worker and
# migrate containers with env_file, then OVERRIDES the connection strings with
# in-network hostnames (postgres, redis, minio). The `localhost` values here are
# for running the API on your machine against the dockerised data stores.
#
# .env is gitignored. Never commit it; never paste its values into an issue.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- PostgreSQL + PostGIS -----------------------------------------------------
# Two roles, two connection strings (specs/001-triptrackr-mvp/contracts/
# data-access-policy.md §1, research D-20). The API must NEVER be given the
# owner URL: row-level security does not apply to a superuser or a table owner,
# so pointing the API at the owner silently disables every privacy policy while
# every behavioural test keeps passing.
#
# The container's superuser — also the database owner. Compose reads these
# three to start Postgres.
POSTGRES_USER=triptrackr
POSTGRES_PASSWORD=triptrackr
POSTGRES_DB=triptrackr

# Owner connection string. Used ONLY by the one-shot migration runner
# (`npm run db:migrate -w apps/api`, compose service `migrate`) and by the geo
# catalogue import. Must match POSTGRES_* above.
MIGRATION_DATABASE_URL=postgresql://triptrackr:triptrackr@localhost:5432/triptrackr

# Password of the non-superuser API role `triptrackr_api`. The migration runner
# applies it (ALTER ROLE triptrackr_api PASSWORD ...) so the role is usable
# before the API first connects. It is embedded in DATABASE_URL, so keep it
# URL-safe — generate with: openssl rand -hex 32
API_DB_PASSWORD=triptrackr-api-dev

# API-role connection string — what the API and the worker connect as. The user
# is always `triptrackr_api` and the password is API_DB_PASSWORD.
DATABASE_URL=postgresql://triptrackr_api:triptrackr-api-dev@localhost:5432/triptrackr

# --- Redis (sessions, rate limits, planner cache, BullMQ) -----------------------
REDIS_URL=redis://localhost:6379

# --- Tokens ---------------------------------------------------------------------
# Generate each with: openssl rand -base64 48   (schema requires >= 32 characters)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Object storage (S3-compatible) ---------------------------------------------
# MinIO in development; Cloudflare R2 (or any S3-compatible bucket) in production.
# Private buckets only — objects are served through short-lived signed URLs.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=triptrackr
S3_SECRET_ACCESS_KEY=triptrackr-dev-secret
S3_BUCKET_PHOTOS=triptrackr-photos
S3_BUCKET_DOCUMENTS=triptrackr-documents
S3_SIGNED_URL_TTL_SECONDS=300

# --- Document encryption (FR-033) -----------------------------------------------
# Envelope-encryption master key: EXACTLY 32 random bytes, base64 (44 chars).
# Generate with: openssl rand -base64 32
# Losing this key loses every stored travel document. Back it up off the server.
DOCUMENT_MASTER_KEY=
DOCUMENT_MASTER_KEY_ID=v1

# --- Business-tunable (FR-074) — nothing in the design may assume these numbers --
FREE_TRIP_ALLOWANCE=5
TOMBSTONE_RETENTION_DAYS=90

# --- Metered external services --------------------------------------------------
MAPBOX_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# --- Transactional email (verification, password reset) -------------------------
# Real Resend keys start with `re_`. Outside production, any other value in
# RESEND_API_KEY (e.g. `dev`) makes the API LOG each email instead of sending
# it — the verification link appears in the API log, which is how the flow is
# exercised locally. Production always sends and fails loudly on a bad key.
# EMAIL_FROM is the sender Resend is asked to use; its domain must be verified
# in Resend. APP_PUBLIC_URL is the web origin the emailed links point at
# (/verify-email, /reset-password); universal links hand it to the app.
EMAIL_FROM="TripTrackr <no-reply@triptrackr.app>"
APP_PUBLIC_URL=https://triptrackr.app

# --- OAuth sign-in (FR-002) — optional -------------------------------------------
# Comma-separated audiences the API accepts provider tokens for. Google: the
# iOS and Android OAuth client ids (the same values as EXPO_PUBLIC_GOOGLE_*
# below). Apple: the app's bundle identifier, plus any Services ID. Leave a
# provider empty and its endpoint answers 503 OAUTH_PROVIDER_UNAVAILABLE rather
# than accepting a token it could not have checked against any audience.
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=

# Planner quota per account per day (FR-069) and cache window (FR-070).
PLANNER_DAILY_REQUEST_LIMIT=10
PLANNER_CACHE_TTL_SECONDS=86400

# --- Billing (RevenueCat, research D-07) ----------------------------------------
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# --- Observability (FR-073) — optional -------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Mobile app. EXPO_PUBLIC_* variables are inlined into the JS bundle at build
# time, which means they are readable by anyone who has the app. Only put
# publishable values here — never a secret. On a physical device,
# EXPO_PUBLIC_API_URL must be your machine's LAN address, not localhost.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Google Sign-In (FR-002). OAuth client ids from the Google Cloud console — one
# per platform. They are public identifiers, not secrets. Leave both empty and
# the app hides the Google button; the API must list the same ids in
# GOOGLE_OAUTH_CLIENT_IDS or it will refuse the tokens.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Build-time only, never bundled: used by EAS to upload Sentry source maps and
# by @rnmapbox/maps to fetch the private SDK from Mapbox's registry. In EAS,
# store these as EAS secrets, not in this file.
SENTRY_AUTH_TOKEN=
MAPBOX_DOWNLOADS_TOKEN=

# ---------------------------------------------------------------------------
# Production only (infra/docker-compose.prod.yml). No defaults are honoured
# there: a missing POSTGRES_PASSWORD, API_DB_PASSWORD, API_HOST or ACME_EMAIL
# aborts `docker compose up`. Run Compose from the repository root with
# `--env-file .env` so these are seen.
# ---------------------------------------------------------------------------
API_HOST=api.localhost
ACME_EMAIL=

# --- Backups (compose service `backup`; infra/scripts/README.md) ----------------
# Nightly pg_dump at BACKUP_AT (UTC). Local copies are kept BACKUP_RETENTION_DAYS.
BACKUP_AT=03:00
BACKUP_RETENTION_DAYS=14
# Off-box copy — strongly recommended. Any S3-compatible endpoint (Backblaze B2,
# Cloudflare R2, ...). Use a key that can write but not delete. Leave
# BACKUP_S3_ENDPOINT empty to keep local copies only.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
