# Copy to .env and fill in. Every variable here is validated at API startup
# (server/src/common/config/env.schema.ts) — a missing one stops the boot.

NODE_ENV=development
PORT=3000

# Postgres (matches infra/docker-compose.yml defaults)
POSTGRES_USER=triptrackr
POSTGRES_PASSWORD=triptrackr
POSTGRES_DB=triptrackr
DATABASE_URL=postgresql://triptrackr:triptrackr@localhost:5432/triptrackr

REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# MinIO in development; Cloudflare R2 in production. Private buckets only.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=triptrackr
S3_SECRET_ACCESS_KEY=triptrackr-dev-secret
S3_BUCKET_PHOTOS=triptrackr-photos
S3_BUCKET_DOCUMENTS=triptrackr-documents
S3_SIGNED_URL_TTL_SECONDS=300

# Envelope encryption for documents (FR-033). Generate with: openssl rand -base64 32
DOCUMENT_MASTER_KEY=
DOCUMENT_MASTER_KEY_ID=v1

# Business-tunable (FR-074) — nothing in the design may assume this number.
FREE_TRIP_ALLOWANCE=5
TOMBSTONE_RETENTION_DAYS=90

MAPBOX_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
RESEND_API_KEY=

PLANNER_DAILY_REQUEST_LIMIT=10
PLANNER_CACHE_TTL_SECONDS=86400

REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

SENTRY_DSN=

# ---------------------------------------------------------------------------
# Mobile app. EXPO_PUBLIC_* variables are inlined into the JS bundle at build
# time, which means they are readable by anyone who has the app. Only put
# publishable values here — never a secret.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Build-time only, never bundled: used by EAS to upload Sentry source maps and
# by @rnmapbox/maps to fetch the private SDK from Mapbox's registry.
SENTRY_AUTH_TOKEN=
MAPBOX_DOWNLOADS_TOKEN=

# Production only
API_HOST=api.localhost
ACME_EMAIL=
